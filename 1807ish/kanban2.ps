# ============================================================
# ClipSense Kanban Board Rebuild - FULLY FIXED
# ============================================================
# Run inside the ClipSense repo.
#
# This script:
# - Detects the repo automatically.
# - Finds the existing GitHub Project named ClipSense.
# - Removes PROJECT CARDS only.
# - Does NOT delete issues.
# - Does NOT close issues.
# - Does NOT reopen closed issues.
# - Does NOT create Rank.
# - Reuses OPEN issues by exact title.
# - Creates missing issues.
# - Adds issues to project.
# - Sets Status.
# - Sets Priority if the Priority field exists.
# ============================================================

$ErrorActionPreference = "Stop"

$ProjectTitle = "ClipSense"

# ------------------------------------------------------------
# Detect repo and project owner
# ------------------------------------------------------------

gh auth status | Out-Null

$Repo = gh repo view --json nameWithOwner -q ".nameWithOwner"
$ProjectOwner = gh repo view --json owner -q ".owner.login"

Write-Host "Repo: $Repo" -ForegroundColor Cyan
Write-Host "Project owner: $ProjectOwner" -ForegroundColor Cyan
Write-Host "Project title: $ProjectTitle" -ForegroundColor Cyan

# ------------------------------------------------------------
# Find project
# ------------------------------------------------------------

$Projects = gh project list --owner $ProjectOwner --format json | ConvertFrom-Json
$Project = @($Projects.projects) | Where-Object { $_.title -eq $ProjectTitle } | Select-Object -First 1

if (-not $Project) {
  throw "Project '$ProjectTitle' not found under '$ProjectOwner'."
}

$ProjectNumber = $Project.number
$ProjectView = gh project view $ProjectNumber --owner $ProjectOwner --format json | ConvertFrom-Json
$ProjectId = $ProjectView.id

Write-Host "Found project: $ProjectTitle #$ProjectNumber" -ForegroundColor Green

# ------------------------------------------------------------
# Fields
# ------------------------------------------------------------

$Fields = gh project field-list $ProjectNumber --owner $ProjectOwner --format json | ConvertFrom-Json

$StatusField = @($Fields.fields) | Where-Object { $_.name -eq "Status" } | Select-Object -First 1
if (-not $StatusField) {
  throw "Missing project field: Status"
}

$StatusFieldId = $StatusField.id

function Get-StatusOptionId {
  param(
    [string[]]$Names,
    [bool]$Required = $true
  )

  foreach ($Name in $Names) {
    $Option = @($StatusField.options) | Where-Object { $_.name -eq $Name } | Select-Object -First 1
    if ($Option) {
      return $Option.id
    }
  }

  if ($Required) {
    throw "Missing Status option. Tried: $($Names -join ', ')"
  }

  return $null
}

# Map script-internal status names to actual project column names
$StatusOptions = @{
  "In Progress" = Get-StatusOptionId @("In progress", "In Progress")
  "Ready"       = Get-StatusOptionId @("Ready")
  "Backlog"     = Get-StatusOptionId @("Product Backlog", "Backlog")
  "Icebox"      = Get-StatusOptionId @("Icebox")

  # Optional (script never places cards here, but keeps mappings for completeness)
  "Review"      = Get-StatusOptionId @("In review", "Review", "In Review") $false
  "Bugged"      = Get-StatusOptionId @("Bugged") $false
  "Done"        = Get-StatusOptionId @("Done") $false
}

$PriorityField = @($Fields.fields) | Where-Object { $_.name -eq "Priority" } | Select-Object -First 1
$PriorityFieldId = $null
$PriorityOptions = @{}

if ($PriorityField) {
  $PriorityFieldId = $PriorityField.id

  foreach ($Priority in @("P0", "P1", "P2", "P3")) {
    $Option = @($PriorityField.options) | Where-Object { $_.name -eq $Priority } | Select-Object -First 1
    if ($Option) {
      $PriorityOptions[$Priority] = $Option.id
    }
  }

  Write-Host "Priority field found." -ForegroundColor Green
}
else {
  Write-Host "Priority field not found. Status will be set, and priority labels will be added." -ForegroundColor Yellow
}

# ------------------------------------------------------------
# Labels
# ------------------------------------------------------------

$LabelsToEnsure = @(
  @{ Name = "type:user-story"; Color = "5319e7"; Description = "User story" },
  @{ Name = "type:bug"; Color = "d73a4a"; Description = "Bug or broken behavior" },
  @{ Name = "type:feature"; Color = "0e8a16"; Description = "Feature or capability" },
  @{ Name = "type:qa"; Color = "fbca04"; Description = "Testing and verification" },
  @{ Name = "type:security"; Color = "b60205"; Description = "Security, validation, auth, vulnerabilities" },
  @{ Name = "type:doc"; Color = "0075ca"; Description = "Documentation" },
  @{ Name = "type:chore"; Color = "cfd3d7"; Description = "Maintenance chore" },

  @{ Name = "priority:p0"; Color = "b60205"; Description = "Critical MVP blocker" },
  @{ Name = "priority:p1"; Color = "d93f0b"; Description = "Important MVP work" },
  @{ Name = "priority:p2"; Color = "fbca04"; Description = "Useful but not immediate" },
  @{ Name = "priority:p3"; Color = "cfd3d7"; Description = "Future work" },

  @{ Name = "scope:mvp"; Color = "0052cc"; Description = "Required for MVP" },
  @{ Name = "scope:stabilization"; Color = "1d76db"; Description = "Stabilization work" },
  @{ Name = "scope:roadmap"; Color = "c2e0c6"; Description = "Roadmap work" },
  @{ Name = "scope:post-mvp"; Color = "bfdadc"; Description = "Post-MVP work" },

  @{ Name = "service:web"; Color = "f9d0c4"; Description = "Next.js web app" },
  @{ Name = "service:api"; Color = "d4c5f9"; Description = "Go API" },
  @{ Name = "service:worker"; Color = "c5def5"; Description = "Python worker" },
  @{ Name = "service:docker"; Color = "bfd4f2"; Description = "Docker/runtime" },
  @{ Name = "service:postgres"; Color = "bfe5bf"; Description = "Postgres" },
  @{ Name = "service:redis"; Color = "fef2c0"; Description = "Redis" },
  @{ Name = "service:qdrant"; Color = "d1f0ff"; Description = "Qdrant" }
)

$ExistingLabels = gh label list --repo $Repo --limit 1000 --json name | ConvertFrom-Json

foreach ($Label in $LabelsToEnsure) {
  $Found = @($ExistingLabels) | Where-Object { $_.name -eq $Label.Name } | Select-Object -First 1

  if (-not $Found) {
    gh label create $Label.Name `
      --repo $Repo `
      --color $Label.Color `
      --description $Label.Description | Out-Null
  }
}

# ------------------------------------------------------------
# Clear project cards only
# ------------------------------------------------------------

Write-Host "Clearing project cards only..." -ForegroundColor Yellow

do {
  $ItemsJson = gh project item-list $ProjectNumber --owner $ProjectOwner --limit 100 --format json | ConvertFrom-Json
  $Items = @($ItemsJson.items)

  foreach ($Item in $Items) {
    gh project item-delete $ProjectNumber `
      --owner $ProjectOwner `
      --id $Item.id | Out-Null
  }
} while ($Items.Count -gt 0)

# ------------------------------------------------------------
# Helpers
# ------------------------------------------------------------

function New-IssueBody {
  param(
    [string]$Purpose,
    [string[]]$Acceptance,
    [string]$Status,
    [string]$Priority
  )

  $AcceptanceText = ""
  foreach ($Item in $Acceptance) {
    $AcceptanceText += "- [ ] $Item`n"
  }

  return @"
## Purpose

$Purpose

## Acceptance Criteria

$AcceptanceText
## Kanban Placement

Status: $Status

Priority: $Priority

## Agile Reset Rule

Repository evidence can inform this card, but it does not make this card Done.

This card becomes Done only after it is pulled, verified against acceptance criteria in this delivery cycle, reviewed, and accepted.
"@
}

function Get-OrCreate-OpenIssue {
  param(
    [string]$Title,
    [string]$Body,
    [string[]]$Labels
  )

  $Search = "repo:$Repo in:title `"$Title`""

  # Argument splatting to preserve spaces in the search query
  $listArgs = @(
    "issue", "list",
    "--repo", $Repo,
    "--state", "open",
    "--search", $Search,
    "--limit", "100",
    "--json", "number,title,url"
  )
  $Existing = gh @listArgs | ConvertFrom-Json

  $Exact = @($Existing) | Where-Object { $_.title -eq $Title } | Select-Object -First 1

  if ($Exact) {
    $editArgs = @(
      "issue", "edit", $Exact.number,
      "--repo", $Repo,
      "--add-label", ($Labels -join ",")
    )
    gh @editArgs | Out-Null
    return $Exact.url
  }

  $createArgs = @(
    "issue", "create",
    "--repo", $Repo,
    "--title", $Title,
    "--body", $Body
  )
  foreach ($Label in $Labels) {
    $createArgs += "--label"
    $createArgs += $Label
  }
  return gh @createArgs
}

function Add-ToProject {
  param(
    [string]$IssueUrl,
    [string]$Status,
    [string]$Priority
  )

  $ProjectItem = gh project item-add $ProjectNumber `
    --owner $ProjectOwner `
    --url $IssueUrl `
    --format json | ConvertFrom-Json

  gh project item-edit `
    --id $ProjectItem.id `
    --project-id $ProjectId `
    --field-id $StatusFieldId `
    --single-select-option-id $StatusOptions[$Status] | Out-Null

  if ($PriorityFieldId -and $PriorityOptions.ContainsKey($Priority)) {
    gh project item-edit `
      --id $ProjectItem.id `
      --project-id $ProjectId `
      --field-id $PriorityFieldId `
      --single-select-option-id $PriorityOptions[$Priority] | Out-Null
  }
}

function Add-Card {
  param(
    [string]$Title,
    [string]$Status,
    [string]$Priority,
    [string]$Purpose,
    [string[]]$Labels,
    [string[]]$Acceptance
  )

  $Body = New-IssueBody `
    -Purpose $Purpose `
    -Acceptance $Acceptance `
    -Status $Status `
    -Priority $Priority

  $IssueUrl = Get-OrCreate-OpenIssue `
    -Title $Title `
    -Body $Body `
    -Labels $Labels

  Add-ToProject `
    -IssueUrl $IssueUrl `
    -Status $Status `
    -Priority $Priority

  Write-Host "Placed: $Title -> $Status / $Priority" -ForegroundColor Green
}

