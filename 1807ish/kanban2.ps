    Acceptance = @(
      "Docs reflect current Go status.",
      "Docs reflect current Docker blocker.",
      "Docs distinguish ZIP MVP from future direct video and link intake.",
      "Docs do not overclaim runtime verification."
    )
  }

  @{
    Title = "CS-105: Postgres Connection Pooling and Health-Check Handshake"
    Status = "Backlog"
    Priority = "P1"
    Labels = @("type:feature","priority:p1","scope:stabilization","service:api","service:postgres")
    Purpose = "Add resilient DB connection handling so API survives late Postgres boot."
    Acceptance = @(
      "API retries Postgres connection with bounded backoff.",
      "API exposes DB health through /api/health.",
      "API does not crash immediately if Postgres starts late.",
      "Failed DB connection returns clear health failure."
    )
  }

  @{
    Title = "CS-106: Disk-Space Janitor and TTL Cleanup Daemon"
    Status = "Backlog"
    Priority = "P2"
    Labels = @("type:feature","priority:p2","scope:stabilization","service:worker")
    Purpose = "Clean old uploads, extracted files, temporary audio, and processing artifacts safely."
