      "Failed batches keep only required diagnostics.",
      "Cleanup runs on predictable interval.",
      "Cleanup cannot delete active in-progress files.",
      "Disk usage does not grow forever."
    )
  }

  @{
    Title = "CS-116: Replace Legacy SQLite Backup/Restore Scripts"
    Status = "Backlog"
    Priority = "P2"
    Labels = @("type:chore","priority:p2","scope:stabilization","service:postgres")
