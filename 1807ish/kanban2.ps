# ------------------------------------------------------------
# Create / reuse / place cards
# ------------------------------------------------------------

foreach ($Card in $Cards) {
  Add-Card `
    -Title $Card.Title `
    -Status $Card.Status `
    -Priority $Card.Priority `
    -Purpose $Card.Purpose `
    -Labels $Card.Labels `
    -Acceptance $Card.Acceptance
}

