    Priority = "P0"
    Labels = @("type:bug","priority:p0","scope:mvp","service:web")
    Purpose = "Prevent protected pages from redirecting before localStorage token loads."
    Acceptance = @(
      "Logged-in users can refresh protected pages without false redirect.",
      "Missing-token users still redirect to login.",
      "Auth loading state is explicit."
    )
  }

  @{
    Title = "CS-304: Frontend Network Interceptor and Global Error Toast System"
    Status = "Backlog"
    Priority = "P1"
    Labels = @("type:feature","priority:p1","scope:mvp","service:web")
    Purpose = "Add global API error handling so failures do not leave user stuck."
    Acceptance = @(
      "API failures trigger visible error toasts.",
      "Upload failures show clear reasons.",
      "Auth failures redirect or notify correctly.",
      "Long-running batch errors do not leave UI stuck.",
      "Network disconnects show recoverable state.",
      "Error messages are safe."
    )
  }

  @{
    Title = "CS-405: MVP Batch Export and Future Narrative Package Export"
    Status = "Backlog"
    Priority = "P2"
    Labels = @("type:feature","priority:p2","scope:mvp","service:web","service:api")
    Purpose = "Fix MVP authenticated JSON or CSV export and defer editor-ready exports."
    Acceptance = @(
      "MVP export works with auth.",
      "Export includes batch, clips, and storyline order where available.",
      "Advanced editor-ready export is deferred."
    )
  }

  @{
    Title = "CS-113: Frontend Dependency Vulnerability Cleanup"
    Status = "Backlog"
    Priority = "P1"
    Labels = @("type:security","priority:p1","scope:stabilization","service:web")
    Purpose = "Resolve or explicitly triage known frontend dependency vulnerabilities."
    Acceptance = @(
      "Upgrade plan is reviewed.",
      "Vulnerable dependencies are upgraded where safe.",
      "npm ci, npm run build, and npm audit are rerun.",
      "Remaining vulnerabilities are documented with accepted risk."
    )
  }

  @{
    Title = "CS-115: CI Build/Test Validation"
    Status = "Backlog"
    Priority = "P1"
    Labels = @("type:qa","priority:p1","scope:stabilization","service:api","service:worker","service:web","service:docker")
    Purpose = "Keep CI aligned with actual repo commands and dependency boundaries."
    Acceptance = @(
      "CI runs on PRs and pushes to main.",
      "API job runs Go commands from apps/api.",
      "Worker job runs compile and tests from apps/api/ai_worker.",
      "Web job runs npm ci and build from apps/web.",
      "Compose job validates docker compose config."
    )
  }

  @{
    Title = "CS-208: End-to-End ZIP MVP Verification Gate"
    Status = "Backlog"
    Priority = "P0"
    Labels = @("type:qa","priority:p0","scope:mvp","service:docker","service:web","service:api","service:worker","service:postgres","service:redis","service:qdrant")
    Purpose = "Run and record the full ZIP upload-to-analysis runtime verification."
    Acceptance = @(
      "Docker Compose boots all services.",
      "API health returns DB and Redis health.",
      "Web loads locally.",
      "Register and login works.",
      "ZIP upload creates pending batch and Redis job.",
      "Worker consumes job.",
      "Worker extracts videos safely.",
      "Batch becomes complete or failed with visible reason.",
      "Successful run writes clips and storyline to Postgres.",
      "Qdrant upsert succeeds or failure is documented."
    )
  }

  @{
    Title = "CS-117: Stabilization Documentation Refresh"
    Status = "Backlog"
    Priority = "P1"
    Labels = @("type:doc","priority:p1","scope:stabilization")
