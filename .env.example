API_ADDR=:8080
DATABASE_URL=postgres://clipsense:clipsense@localhost:5432/clipsense?sslmode=disable
REDIS_URL=redis://localhost:6379
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=clipsense_clips
UPLOAD_DIR=data/uploads
PROCESS_DIR=data/processing
WHISPER_MODEL=small
NEXT_PUBLIC_API_URL=http://localhost:8080
# Explicit local-only mode. Production/test require base64-encoded 32-64 random bytes.
APP_ENV=development
JWT_SECRET=
AUTH_MAX_ATTEMPTS=10
AUTH_WINDOW_SECONDS=60
# Total multipart request bytes, including all headers/fields and ZIP content.
MAX_UPLOAD_REQUEST_BYTES=210763776
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
